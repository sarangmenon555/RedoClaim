{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "runtime": "python",
      "entrypoint": "main.py"
    }
  },
  "regions": [
    "bom1"
  ],
  "cleanUrls": true
}
